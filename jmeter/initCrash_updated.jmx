            <stringProp name="script">import java.util.UUID
import java.util.Random

def rand = new Random()

vars.put(&quot;deviceId&quot;, UUID.randomUUID().toString())
vars.put(&quot;sessionId&quot;, UUID.randomUUID().toString())


log.info(&quot;deviceId=&quot; + vars.get(&quot;deviceId&quot;))
log.info(&quot;sessionId=&quot; + vars.get(&quot;sessionId&quot;))
log.info(&quot;randomLevel=&quot; + vars.get(&quot;randomLevel&quot;))
log.info(&quot;randomErrorType=&quot; + vars.get(&quot;randomErrorType&quot;))
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
