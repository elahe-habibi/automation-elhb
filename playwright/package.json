{
  "name": "playwright-test",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "format": "prettier --write \"**/*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,json,md}\"",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "lint:report": "eslint . --ext .ts,.js --format=html --output-file=eslint-report.html",
    "check": "npm run lint && npm run format:check",
    "check:fix": "npm run lint:fix && npm run format",
    "test": "playwright test --headless",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "این پروژه شامل تست‌های Playwright برای اتوماسیون فرآیند ایجاد دسته‌بندی در سیستم است.",
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.18",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^2.2.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.5.3",
    "typescript": "~5.3.3"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "playwright": "^1.52.0",
    "playwright-core": "^1.52.0",
    "undici-types": "^6.21.0"
  },
  "repository": {
    "type": "git",
    "url": "http://gp.devpod.ir/pod/clasor/playwright.git"
  },
  "type": "commonjs"
}
