{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "*": ["*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["e2e/**/*", "*.ts", "*.js"],
  "exclude": [
    "node_modules",
    "playwright-report",
    "test-results",
    "dist",
    "build"
  ]
}
